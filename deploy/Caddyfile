# Статика: напрямую из apps/web/dist (без копирования в /var/www).
#
# TLS: Caddy сам получает и обновляет сертификат (Let's Encrypt / ACME).
# Перед первым запуском: A-запись mlaffon.fun → IP этого VPS; порты 80 и 443 свободны для caddy;
# ничего не должно занимать :80 (иначе остановите nginx и т.п.).
#
# Раскомментируйте email — Let's Encrypt пришлёт уведомления о сроке (рекомендуется).
{
	 email itoly569@gmail.com
}

# Если сертификат УЖЕ выдан вручную (certbot / регистратор) — используйте
# deploy/Caddyfile.manual-certs вместо этого файла.
#
# Скопируйте: sudo cp /opt/mlaffon/mlaffon-tg-app/deploy/Caddyfile /etc/caddy/Caddyfile
# Формат: sudo caddy fmt --overwrite /etc/caddy/Caddyfile
#
# Ошибка: listen tcp :80: address already in use — порт 80 занят (часто Nginx):
#   sudo ss -tlnp | grep ':80'
#   sudo systemctl stop nginx && sudo systemctl disable nginx
#   затем: sudo systemctl enable --now caddy
#
# Статика: apps/web/dist после npm run build. При 403 на файлы:
#   sudo chmod -R o+rX /opt/mlaffon/mlaffon-tg-app/apps/web/dist
#
# Поддомен admin.* — не второй Caddy: тот же файл, после pull + npm run build:
#   DNS: A (или CNAME) admin.mlaffon.fun → тот же IP, что и основной домен
#   sudo chmod -R o+rX /opt/mlaffon/mlaffon-tg-app/apps/admin/dist
#   sudo cp .../deploy/Caddyfile /etc/caddy/Caddyfile && sudo caddy fmt --overwrite /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
# TLS для admin выдаст Let's Encrypt автоматически (как для основного сайта).

mlaffon.fun {
	root * /opt/mlaffon/mlaffon-tg-app/apps/web/dist
	encode gzip

	# Security headers (CSP: Telegram Mini App — frame-ancestors, без X-Frame-Options DENY)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; frame-ancestors 'self' https://web.telegram.org https://telegram.org; connect-src 'self' https://mlaffon.fun wss://mlaffon.fun; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'self'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3001 {
			flush_interval -1
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

# Админка: отдельный поддомен, тот же API по /api/*
admin.mlaffon.fun {
	root * /opt/mlaffon/mlaffon-tg-app/apps/admin/dist
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; connect-src 'self' https://admin.mlaffon.fun https://mlaffon.fun wss://admin.mlaffon.fun wss://mlaffon.fun; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'self'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3001 {
			flush_interval -1
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
