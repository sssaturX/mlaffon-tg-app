# Скопируйте в deploy/deploy.env на сервере (рядом с redeploy.sh в репо: deploy/deploy.env).
# Скрипт deploy/redeploy.sh подхватит файл перед npm run build.
#
# --- Автоподстановка в apps/api/.env (redeploy) ---
# По умолчанию (DEPLOY_MERGE_DEPLOY_ENV_INTO_API=1) пустые ключи в apps/api/.env
# дополняются из export ниже: NODE_ENV, PUBLIC_WEB_URL, PUBLIC_ADMIN_URL, CORS_ORIGINS,
# плюс медиа (если заданы): MEDIA_S3_BUCKET, MEDIA_PUBLIC_BASE_URL, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, MEDIA_S3_REGION, MEDIA_S3_ENDPOINT, MEDIA_S3_FORCE_PATH_STYLE.
# При пустом CORS_ORIGINS скрипт соберёт allowlist: сначала PUBLIC_WEB_URL, иначе MINI_APP_WEB_URL,
# иначе домен из TWITCH_REDIRECT_URI / KICK_REDIRECT_URI (https, не localhost).
# При DEPLOY_CORS_AUTO_ADMIN=1 добавит https://admin.<хост>, плюс PUBLIC_ADMIN_URL из .env или export.
# При DEPLOY_AUTO_PRODUCTION_CORS=1 (по умолчанию) при успешной генерации CORS допишет NODE_ENV=production, если его ещё нет.
#
# Минимум для прод без ручного копирования в .env (можно держать только здесь):
# export NODE_ENV=production
# export PUBLIC_WEB_URL=https://mlaffon.fun
# export PUBLIC_ADMIN_URL=https://admin.mlaffon.fun
# Либо одной строкой CORS:
# export CORS_ORIGINS=https://mlaffon.fun,https://admin.mlaffon.fun
#
# Если в apps/api/.env уже есть эти ключи — export из deploy.env их не перезаписывает.
# DEPLOY_MERGE_DEPLOY_ENV_INTO_API=0 — отключить синхронизацию export → apps/api/.env
# DEPLOY_SKIP_ENV_SECURITY=1 — не трогать CORS и дефолты WS/auth
# DEPLOY_ASSUME_PRODUCTION_API=1 — если в .env нет NODE_ENV, дописать production
# DEPLOY_CORS_AUTO_ADMIN=0 — не добавлять https://admin.<хост> автоматически

# Подпись под меню в мини-аппе и др. (подставляются в Vite при сборке web):
export VITE_BOT_USERNAME=MlaffonBot
# при необходимости:
# export VITE_ALLOW_DEV=0

# Web Push (API): redeploy.sh дописывает в apps/api/.env после npm ci.
# Subject по умолчанию в скрипте — mailto:itoly569@gmail.com; можно переопределить:
# export VAPID_SUBJECT=mailto:itoly569@gmail.com
# Если задать оба ключа, они попадут в apps/api/.env (иначе скрипт оставит уже существующие или сгенерирует новую пару):
# export VAPID_PUBLIC_KEY=
# export VAPID_PRIVATE_KEY=

# Telegram: в apps/api/.env нужен TELEGRAM_BOT_TOKEN (скрипт проверит; обойти: DEPLOY_SKIP_TELEGRAM_CHECK=1).
# Long polling по умолчанию — ничего не экспортируйте ниже.
# Вебхук: либо export TELEGRAM_WEBHOOK_SECRET=... (подтянется в apps/api/.env при деплое), либо один раз:
#   DEPLOY_TELEGRAM_WEBHOOK_SECRET=1 ./deploy/redeploy.sh
# export TELEGRAM_WEBHOOK_SECRET=

