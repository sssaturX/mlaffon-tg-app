# API (copy to apps/api/.env)
DATABASE_URL=postgres://mlaffon:mlaffon@localhost:5432/mlaffon
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_BOT_USERNAME=YourBotName
JWT_SECRET=change-me-in-production-min-32-chars
PORT=3001
HOST=0.0.0.0

# Redis (очередь BullMQ + rate limits + OAuth state)
REDIS_URL=redis://127.0.0.1:6379

# AES-256-GCM для OAuth токенов (32 байта hex или base64, или любая строка — будет scrypt)
TOKENS_ENCRYPTION_KEY=

# Публичный URL фронта — редирект после OAuth (?oauth_ok=)
PUBLIC_WEB_URL=http://localhost:5173

# Twitch OAuth + Helix (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/api/v1/oauth/twitch/callback

# Стрик «заход на стрим»: каналы, за которые считается день (UTC).
# Twitch: логин канала без #; Kick: slug канала. Пока стрим в эфире и подписка на канал (или STREAM_STREAK_REQUIRE_FOLLOW=0).
TWITCH_STREAM_STREAK_BROADCASTER_LOGIN=
KICK_STREAM_STREAK_CHANNEL_SLUG=
# 0 — не требовать подписку, только OAuth + эфир
# STREAM_STREAK_REQUIRE_FOLLOW=1

# Kick OAuth (https://docs.kick.com — PKCE обязателен)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3001/api/v1/oauth/kick/callback
# Опционально, если база API отличается
# KICK_API_BASE=https://api.kick.com

# Анти-абьюз (опционально)
# ABUSE_CLAIM_PER_USER_PER_MIN=30
# ABUSE_CLAIM_PER_IP_PER_MIN=200
# ABUSE_OAUTH_CALLBACK_PER_IP_PER_MIN=60

# Local dev only: bypass Telegram initData (NEVER enable in production)
ALLOW_DEV_AUTH=1

# Web (optional, apps/web или корень при сборке)
# VITE_ALLOW_DEV=1
# VITE_ALLOW_DEV_STUB=1
# VITE_PRIVACY_POLICY_URL=https://example.com/privacy
# Подпись под нижним меню (без @)
# VITE_BOT_USERNAME=YourBotName
