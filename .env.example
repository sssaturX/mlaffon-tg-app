# ==============================================================================
# Environment Variables — mlaffon-tg-app
# ==============================================================================
# Copy to apps/api/.env and fill in real values.
# NEVER commit real secrets. This file contains ONLY placeholders.
# ==============================================================================

# --- Database ---
DATABASE_URL=postgres://mlaffon:mlaffon@localhost:5432/mlaffon
# PG_POOL_MAX=20
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000
# PG_POOL_METRICS_MS=0

# --- Tracing / logging ---
# API_SLOW_REQUEST_MS=2000
# API_TRACE_MIN_MS=2000
# API_TRACE_SAMPLE_RATE=0
# EVENT_LOOP_MONITOR_MS=0
# EVENT_LOOP_LAG_WARN_MS=100
# LOG_LEVEL=info

# --- Database startup ---
# DB_WAIT_MAX_MS=120000
# DB_WAIT_INTERVAL_MS=500

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_BOT_USERNAME=<your-bot-username>

# --- Auth ---
JWT_SECRET=<generate-with: openssl rand -hex 32>
PORT=3001
HOST=0.0.0.0

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Live broadcast auto-end ---
# LIVE_BROADCAST_AUTO_END_MS=14400000

# --- OAuth token encryption (AES-256-GCM, 32 bytes hex/base64) ---
TOKENS_ENCRYPTION_KEY=<generate-with: openssl rand -base64 32>

# --- Web auth toggle ---
# VITE_ALLOW_WEB_AUTH=1

# --- Public URLs ---
PUBLIC_WEB_URL=http://localhost:5173
# MINI_APP_WEB_URL=https://your-domain.com

# --- Telegram notifications ---
# TELEGRAM_LIVE_NOTIFY_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WELCOME_PHOTO_URL=https://your-domain.com/bot-welcome.png
# TELEGRAM_WELCOME_PHOTO_FILE=
# TELEGRAM_GUIDE_TELEGRAPH_URL=
# TELEGRAM_SUPPORT_URL=

# --- Web Push (VAPID) ---
# Generate: cd apps/api && npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:your-email@example.com

# --- OAuth: Twitch ---
TWITCH_CLIENT_ID=<your-twitch-client-id>
TWITCH_CLIENT_SECRET=<your-twitch-client-secret>
TWITCH_REDIRECT_URI=http://localhost:3001/api/v1/oauth/twitch/callback

# --- OAuth: Kick ---
KICK_CLIENT_ID=<your-kick-client-id>
KICK_CLIENT_SECRET=<your-kick-client-secret>
KICK_REDIRECT_URI=http://localhost:3001/api/v1/oauth/kick/callback
# KICK_API_BASE=https://api.kick.com

# --- Anti-abuse ---
# ABUSE_CLAIM_PER_USER_PER_MIN=30
# ABUSE_CLAIM_PER_IP_PER_MIN=200
# ABUSE_OAUTH_CALLBACK_PER_IP_PER_MIN=60
# ABUSE_WEB_REF_REGISTER_PER_IP_PER_DAY=10

# --- Admin credentials ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<strong-password>
# ADMIN_PASSPHRASE=<strong-passphrase>
# ADMIN_JWT_SECRET=<generate-with: openssl rand -hex 32>

# --- Dev-only (MUST be unset/0 in production) ---
# ALLOW_DEV_AUTH=0
# VITE_ALLOW_DEV=0
# VITE_ALLOW_DEV_STUB=0

# --- Frontend env ---
VITE_BOT_USERNAME=<your-bot-username>
# VITE_PRIVACY_POLICY_URL=
# VITE_CREATOR_DISPLAY_NAME=
# VITE_CREATOR_AVATAR_URL=
# VITE_CREATOR_KICK_LABEL=
# VITE_CREATOR_TWITCH_LABEL=
# VITE_CREATOR_KICK_PAGE_URL=

# --- Media: S3 + CDN ---
# MEDIA_S3_BUCKET=
# MEDIA_PUBLIC_BASE_URL=https://img.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_S3_REGION=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_FORCE_PATH_STYLE=1

# --- Production CORS / security ---
# NODE_ENV=production
# PUBLIC_ADMIN_URL=https://admin.your-domain.com
# CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
# WS_TICKET_TTL_SEC=25
# WS_CONNECT_ATTEMPTS_PER_MINUTE=30
# WS_MAX_CONCURRENT_PER_IP=8
# AUTH_RATE_LIMIT_MAX=15
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- CDN provider (deploy pipeline) ---
# CDN_PROVIDER=yandex
# YC_CDN_RESOURCE_ID=
# YC_FOLDER_ID=
# CF_ZONE_ID=
# CF_API_TOKEN=
