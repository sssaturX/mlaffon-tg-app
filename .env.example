# Redis (очередь BullMQ + rate limits + OAuth state)
REDIS_URL=redis://127.0.0.1:6379

# AES-256-GCM для OAuth токенов (32 байта hex или base64, или любая строка — будет scrypt)
TOKENS_ENCRYPTION_KEY=dg157yPG/sj8JL1i3HFy3wlb6+qz26KOqNEALwY0Zhg=

# Публичный URL фронта — после OAuth API редиректит сюда на /oauth/twitch|kick. Без завершающего слэша.
# Прод (юзеры в Telegram): PUBLIC_WEB_URL=https://mlaffon.fun
# Локально у разработчика: PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# --- OAuth: Twitch / Kick ---
# Redirect URI — это URL **вашего API** (/api/v1/oauth/.../callback), не страница мини-аппа.
# Юзеры из Telegram ходят на **ваш домен**; localhost у них нет. На проде в .env и в консоли Twitch/Kick
# должны быть **https**-URL на тот же домен, что и API (например https://mlaffon.fun/api/v1/oauth/twitch/callback).
# В консоли приложений можно добавить **несколько** redirect URL: и прод, и localhost — для разработки.
#
# Прод (пример):
  TWITCH_REDIRECT_URI=https://mlaffon.fun/api/v1/oauth/twitch/callback
  KICK_REDIRECT_URI=https://mlaffon.fun/api/v1/oauth/kick/callback
# Локально у разработчика (только если тестируете с машины, API на :3001):
#   http://localhost:3001/api/v1/oauth/twitch/callback
# Значение в TWITCH_REDIRECT_URI / KICK_REDIRECT_URI и список в консоли Twitch/Kick должны совпадать побайтово.

# Twitch OAuth + Helix (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=fwqm504cwf7d8h7eiea1uepkvcymg3
TWITCH_CLIENT_SECRET=sd692vdysx5ag5irsyugste5e5evm4
# TWITCH_REDIRECT_URI=http://localhost:3001/api/v1/oauth/twitch/callback

# Kick OAuth (https://docs.kick.com — PKCE обязателен)
KICK_CLIENT_ID=01KMZ12WCEZE5C317MGZ05Y41T
KICK_CLIENT_SECRET=205b23bba536b0696f897228bb445c5a8396a289e92a4dad9834eeabec7c9946
# KICK_REDIRECT_URI=http://localhost:3001/api/v1/oauth/kick/callback
# Опционально, если база API отличается
# KICK_API_BASE=https://api.kick.com

# Анти-абьюз (опционально)
# ABUSE_CLAIM_PER_USER_PER_MIN=30
# ABUSE_CLAIM_PER_IP_PER_MIN=200
# ABUSE_OAUTH_CALLBACK_PER_IP_PER_MIN=60

# Админка (POST /api/admin/login): email + password + passphrase; JWT подпись
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=...
# ADMIN_PASSPHRASE=...
# ADMIN_JWT_SECRET=... # или общий с JWT_SECRET

# Local dev only: bypass Telegram initData (NEVER enable in production)
ALLOW_DEV_AUTH=1

# Web (optional, apps/web или корень при сборке)
# VITE_ALLOW_DEV=1
# VITE_ALLOW_DEV_STUB=1
# VITE_PRIVACY_POLICY_URL=https://example.com/privacy
# Подпись под нижним меню (без @)
VITE_BOT_USERNAME=MlaffonBot
