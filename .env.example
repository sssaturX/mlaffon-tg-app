# API (copy to apps/api/.env)
DATABASE_URL=postgres://mlaffon:mlaffon@localhost:5432/mlaffon
# После docker compose down -v API ждёт БД перед listen (по умолчанию до 120 с).
# DB_WAIT_MAX_MS=120000
# DB_WAIT_INTERVAL_MS=500
TELEGRAM_BOT_TOKEN=7771871296:AAGaDNNwrm0WU6fXaeTXWvh_RPrqWD1A9vk
TELEGRAM_BOT_USERNAME=MlaffonBot
JWT_SECRET=65281d83c32bd52cb17575850f7a2f8541a26ea923ec35a8742035157b16afa2
PORT=3001
HOST=0.0.0.0

# Redis (очередь BullMQ + rate limits + OAuth state)
REDIS_URL=redis://127.0.0.1:6379

# AES-256-GCM для OAuth токенов (32 байта hex или base64, или любая строка — будет scrypt)
TOKENS_ENCRYPTION_KEY=dg157yPG/sj8JL1i3HFy3wlb6+qz26KOqNEALwY0Zhg=

# Веб: вход email/пароль в браузере (по умолчанию включён). Отключить: VITE_ALLOW_WEB_AUTH=0
# VITE_ALLOW_WEB_AUTH=1

# Публичный URL фронта — после OAuth API редиректит сюда на /oauth/twitch|kick. Без завершающего слэша.
# Прод (юзеры в Telegram): PUBLIC_WEB_URL=https://mlaffon.fun
# Локально у разработчика: PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Куда слать уведомление о старте эфира (админка → «Начать эфир»): отправляет **этот же бот**
# (TELEGRAM_BOT_TOKEN) через sendMessage. Добавьте бота в канал/группу и дайте право писать,
# либо укажите chat_id лички/чата. Пример: @my_channel или -1001234567890. Пусто = не слать.
# Отдельно всем, кто нажал /start в личке с ботом, уходит то же сообщение.
#TELEGRAM_LIVE_NOTIFY_CHAT_ID=

# По умолчанию API сам опрашивает Telegram (long polling) — достаточно TELEGRAM_BOT_TOKEN, /start работает без вебхука.
# Если задать секрет ниже — включается только вебхук (polling отключается); тогда нужен setWebhook на https://<домен>/api/v1/telegram/webhook
# и тот же secret_token.
#TELEGRAM_WEBHOOK_SECRET=

# --- Web Push (браузер: старт эфира) ---
# Сгенерировать: cd apps/api && npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# mailto: или https URL контакта (для VAPID subject)
# VAPID_SUBJECT=mailto:santoridev@gmail.com

# HTTPS URL мини-приложения (как в @BotFather → Mini App). Нужен для кнопки «Открыть приложение».
# Если не задано, используется PUBLIC_WEB_URL (должен быть https на проде).
# Пример: https://mlaffon.fun
MINI_APP_WEB_URL=https://mlaffon.fun

# --- OAuth: Twitch / Kick ---
# Redirect URI — это URL **вашего API** (/api/v1/oauth/.../callback), не страница мини-аппа.
# Юзеры из Telegram ходят на **ваш домен**; localhost у них нет. На проде в .env и в консоли Twitch/Kick
# должны быть **https**-URL на тот же домен, что и API (например https://mlaffon.fun/api/v1/oauth/twitch/callback).
# В консоли приложений можно добавить **несколько** redirect URL: и прод, и localhost — для разработки.
#
# Прод (пример):
  TWITCH_REDIRECT_URI=https://mlaffon.fun/api/v1/oauth/twitch/callback
  KICK_REDIRECT_URI=https://mlaffon.fun/api/v1/oauth/kick/callback
# Локально у разработчика (только если тестируете с машины, API на :3001):
#   http://localhost:3001/api/v1/oauth/twitch/callback
# Значение в TWITCH_REDIRECT_URI / KICK_REDIRECT_URI и список в консоли Twitch/Kick должны совпадать побайтово.

# Twitch OAuth + Helix (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=fwqm504cwf7d8h7eiea1uepkvcymg3
TWITCH_CLIENT_SECRET=sd692vdysx5ag5irsyugste5e5evm4
# TWITCH_REDIRECT_URI=http://localhost:3001/api/v1/oauth/twitch/callback

# Kick OAuth (https://docs.kick.com — PKCE обязателен)
KICK_CLIENT_ID=01KMZ12WCEZE5C317MGZ05Y41T
KICK_CLIENT_SECRET=205b23bba536b0696f897228bb445c5a8396a289e92a4dad9834eeabec7c9946
# KICK_REDIRECT_URI=http://localhost:3001/api/v1/oauth/kick/callback
# Опционально, если база API отличается
# KICK_API_BASE=https://api.kick.com

# Анти-абьюз (опционально)
# ABUSE_CLAIM_PER_USER_PER_MIN=30
# ABUSE_CLAIM_PER_IP_PER_MIN=200
# ABUSE_OAUTH_CALLBACK_PER_IP_PER_MIN=60
# Регистрация с сайта с реф-кодом с одного IP за сутки (после — аккаунт без реф-бонуса)
# ABUSE_WEB_REF_REGISTER_PER_IP_PER_DAY=10

# Админка (POST /api/admin/login): email + password + passphrase; JWT подпись
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=...
# ADMIN_PASSPHRASE=...
# ADMIN_JWT_SECRET=... # или общий с JWT_SECRET

# Local dev only: bypass Telegram initData. На проде держите unset/0 и NODE_ENV=production —
# иначе маршруты /api/v1/auth/dev и stub OAuth не отключатся.
ALLOW_DEV_AUTH=0

# Web (optional, apps/web или корень при сборке)
# VITE_ALLOW_DEV=1
# VITE_ALLOW_DEV_STUB=1
# VITE_PRIVACY_POLICY_URL=https://example.com/privacy
# Экран «привяжи Kick/Twitch»: имя стримера, аватар, ссылка на Kick
# VITE_CREATOR_DISPLAY_NAME=MaloyCSer
# VITE_CREATOR_AVATAR_URL=https://…
# VITE_CREATOR_KICK_LABEL=Kick.com/maloycser
# VITE_CREATOR_TWITCH_LABEL=twitch.tv/maloycser
# VITE_CREATOR_KICK_PAGE_URL=https://kick.com/maloycser
# Текст под карточкой эфира (если не задан в админке при старте)
# VITE_STREAM_VPN_NOTE=Для захода на стрим нужен VPN.
# VITE_CREATOR_GREETING=Я создал это приложение специально для своих зрителей…
# Подпись под нижним меню (без @)
VITE_BOT_USERNAME=MlaffonBot
